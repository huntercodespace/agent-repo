# 复制为 resume-agent/.env。不要把真密钥提交进仓库。

# DeepSeek 对话密钥。pi-ai 的 deepseek 提供方会自动读取这个变量。
DEEPSEEK_API_KEY=

# 可选。不填时从已安装的 pi-ai deepseek 目录里选模型：
# 优先 reasoning 为 false 的快速模型；当前 0.99.1 目录里没有这种模型，因此默认 deepseek-flash。
# 可选值以 getBuiltinModels("deepseek") 为准，例如 deepseek-flash、deepseek-v4-pro。
DEEPSEEK_MODEL=

# OpenAI 兼容的 /v1/embeddings。默认是硅基流动上的 BAAI/bge-m3（1024 维）。
# 维度以接口返回为准。更换模型后必须重新 pnpm ingest。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# 后端端口。前端开发服务器默认把 /api 代理到这里。
PORT=8787

# 嵌入式 LanceDB 目录，相对 resume-agent 根目录。ingest 会整表重建。
LANCEDB_PATH=data/lancedb

# 可选。简历原文和静态文件的位置。
# RESUME_DIR=data/resume
# PUBLIC_DIR=data/public

# 公开聊天接口按 IP 限流。
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# 仅本地看界面。设为 1 时 /api/chat 返回预设 SSE，不调用模型，也不需要密钥。
CHAT_MOCK=0
# 演示模式下每条正文和工具结束之间的等待，单位毫秒。
CHAT_MOCK_DELAY_MS=350

# 开发时前端地址，逗号分隔。
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174

# 部署在反向代理后面、需要按 X-Forwarded-For 识别访客时设为 1。
TRUST_PROXY=0
